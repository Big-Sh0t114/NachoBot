{
    "manifest_version": 1,
    "name": "信使插件 (Messenger)",
    "version": "2.0.0",
    "description": "主人专用主动私聊插件 - 通过 planner 动作池或 #convey_<QQ号>，向指定QQ发送消息；其他用户无权使用",
    "author": {
        "name": "Big-Sh0t114",
        "url": "https://github.com/Big-Sh0t114"
    },
    "license": "GPL-v3.0-or-later",
    "host_application": {
        "min_version": "0.10.0"
    },
    "repository_url": "https://github.com/Big-Sh0t114/NachoBot",
    "keywords": [
        "转告",
        "传话",
        "信使",
        "messenger"
    ],
    "categories": [
        "communication"
    ],
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "plugin_info": {
        "is_built_in": true,
        "plugin_type": "action",
        "components": [
            {
                "type": "action",
                "name": "messenger_relay",
                "description": "主人专用：向指定QQ或已认识的用户主动私聊"
            },
            {
                "type": "command",
                "name": "convey",
                "description": "主人向目标QQ私聊发送消息"
            }
        ]
    }
}
