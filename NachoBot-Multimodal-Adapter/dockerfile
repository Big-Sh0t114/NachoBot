FROM python:3.13-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Use the integrated workspace root as the Docker build context.
COPY NachoBot/ncnk_message /NachoBot/ncnk_message
ENV PYTHONPATH=/NachoBot


# 设置工作目录
WORKDIR /nachobot_multimodal_adapter


# 安装依赖
COPY NachoBot-Multimodal-Adapter/pyproject.toml NachoBot-Multimodal-Adapter/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
ENV PATH="/nachobot_multimodal_adapter/.venv/bin:${PATH}"

# 复制项目代码
COPY NachoBot-Multimodal-Adapter/ .

# 创建配置目录并从模板复制默认配置
RUN mkdir -p /nachobot_multimodal_adapter/configs && \
    cp /nachobot_multimodal_adapter/template_configs/base_template.toml /nachobot_multimodal_adapter/configs/base.toml && \
    cp /nachobot_multimodal_adapter/template_configs/gpt-sovits_template.toml /nachobot_multimodal_adapter/configs/gpt-sovits.toml

# 暴露端口
EXPOSE 8070

# 定义可以被映射的卷
VOLUME ["/nachobot_multimodal_adapter/configs"]

# 运行应用
CMD ["python", "main.py"]
