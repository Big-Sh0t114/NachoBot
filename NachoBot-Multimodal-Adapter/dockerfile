FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/

WORKDIR /workspace/NachoBot-Multimodal-Adapter

# Python 3.12 is required by this adapter's <3.13 project constraint.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    libgomp1 \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY . .
COPY --from=nachobot /ncnk_message /workspace/NachoBot/ncnk_message

# Keep a runnable default in the image; Compose normally replaces this with
# the host's persistent configs volume.
RUN mkdir -p configs && \
    cp template_configs/base_template.toml configs/base.toml && \
    cp template_configs/perception_template.toml configs/perception.toml && \
    cp template_configs/gpt-sovits_template.toml configs/gpt-sovits.toml && \
    cp template_configs/vox_template.toml configs/vox.toml

ENV PATH="/workspace/NachoBot-Multimodal-Adapter/.venv/bin:${PATH}" \
    PYTHONPATH=/workspace/NachoBot \
    PYTHONUNBUFFERED=1

EXPOSE 8070

VOLUME ["/workspace/NachoBot-Multimodal-Adapter/configs", "/workspace/NachoBot-Multimodal-Adapter/models", "/workspace/NachoBot-Multimodal-Adapter/logs"]

ENTRYPOINT ["python", "main.py"]
