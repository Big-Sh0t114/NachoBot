from typing import Optional


class Live2DRenderer:
    def __init__(
        self, model_path: str, logger: logging.Logger, command_queue: queue.Queue
    ):
        self.model_path = model_path
        self.logger = logger
        self.command_queue = command_queue
        self.running = False
        self.model = None

        # Screen config
        self.display: Optional[pygame.Surface] = None
        self.width = 800
        self.height = 600

    def init_pygame(self):
        pygame.init()
        # Initialize OpenGL context
        pygame.display.set_mode(
            (self.width, self.height), pygame.DOUBLEBUF | pygame.OPENGL
        )
        pygame.display.set_caption("NachoBot Live2D Renderer")

        # Init Live2D
        live2d.init()

        # Load Model
        # Ensure path is absolute for safety
        abs_path = os.path.abspath(self.model_path)
        if not os.path.exists(abs_path):
            self.logger.error(f"Live2D Model path not found: {abs_path}")
            return

        self.logger.info(f"Loading Live2D Model: {abs_path}")
        self.model = live2d.LAppModel()
        self.model.LoadModelJson(abs_path)

        # Initial resize
        self.model.Resize(self.width, self.height)

    def run(self):
        try:
            self.init_pygame()
        except Exception as e:
            self.logger.critical(f"Failed to initialize PyGame/Live2D: {e}")
            return

        self.running = True
        self.logger.info("Live2D Renderer Started")

        clock = pygame.time.Clock()

        while self.running:
            # 1. Process PyGame Events
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    self.running = False
                    break
                if event.type == pygame.MOUSEBUTTONDOWN:
                    x, y = pygame.mouse.get_pos()
                    if self.model:
                        self.model.Touch(x, y)
                if event.type == pygame.MOUSEMOTION:
                    x, y = pygame.mouse.get_pos()
                    if self.model:
                        self.model.Drag(x, y)

            # 2. Process Command Queue
            while not self.command_queue.empty():
                try:
                    cmd_type, cmd_data = self.command_queue.get_nowait()
                    self._handle_command(cmd_type, cmd_data)
                except queue.Empty:
                    break
                except Exception as e:
                    self.logger.error(f"Renderer command error: {e}")

            # 3. Render Frame
            live2d.clearBuffer()

            if self.model:
                clock.tick(60)  # Limit to 60 FPS
                self.model.Update()
                self.model.Draw()

            pygame.display.flip()

        # Cleanup
        live2d.dispose()
        pygame.quit()
        self.logger.info("Live2D Renderer Stopped")

    def _handle_command(self, cmd_type: str, cmd_data: str):
        if not self.model:
            return

        self.logger.debug(f"Render Command: {cmd_type} -> {cmd_data}")

        if cmd_type == "emotion":
            # Example: SetExpression logic (if model supports expressions by name)
            # V3 sdk usage: model.SetExpression(name)
            self.model.SetExpression(cmd_data)

        elif cmd_type == "body_action":
            # Example: StartMotion logic
            # V3 sdk usage: model.StartMotion(group, no, priority)
            # Data format might be "Group_Index" e.g "TapBody_0"
            parts = cmd_data.split("_")
            group = parts[0]
            no = 0
            if len(parts) > 1:
                try:
                    no = int(parts[1])
                except ValueError:
                    pass

            # Default priority 3 (Force)
            self.model.StartMotion(group, no, 3)

        elif cmd_type == "motion":
            # Generic motion command
            self.model.StartMotion(cmd_data, 0, 3)

        elif cmd_type == "lip_sync":
            # Lip sync value (0.0 - 1.0)
            try:
                # self.model.SetLipSync(float(cmd_data)) # Check API availability
                pass
            except ValueError:
                pass
